<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>I'm Sorry ❤️</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(135deg, #ff5f7e, #ff9ab2);
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    .box {
        width: 90%;
        max-width: 380px;
        background: white;
        border-radius: 25px;
        padding: 35px 25px;
        text-align: center;
        box-shadow: 0 10px 35px rgba(0,0,0,0.25);
        position: relative;
        z-index: 10;
    }

    .emoji {
        font-size: 70px;
    }

    h1 {
        color: #ff3d68;
        margin: 15px 0 25px;
    }

    input {
        width: 100%;
        height: 50px;
        padding: 10px 15px;
        border: 2px solid #ffb5c4;
        border-radius: 12px;
        font-size: 16px;
        outline: none;
    }

    button {
        width: 100%;
        height: 50px;
        margin-top: 15px;
        border: 0;
        border-radius: 12px;
        background: #ff3d68;
        color: white;
        font-size: 17px;
        font-weight: bold;
        cursor: pointer;
    }

    #result {
        min-height: 30px;
        margin-top: 20px;
        color: #ff3d68;
        font-size: 21px;
        font-weight: bold;
    }

    .heart {
        position: fixed;
        bottom: -60px;
        font-size: 35px;
        z-index: 5;
        animation: heartUp 3s linear forwards;
        pointer-events: none;
    }

    @keyframes heartUp {
        0% {
            bottom: -60px;
            opacity: 0;
            transform: scale(0.3);
        }

        15% {
            opacity: 1;
            transform: scale(1.2);
        }

        100% {
            bottom: 110vh;
            opacity: 0;
            transform: scale(1) rotate(360deg);
        }
    }
</style>
</head>

<body>

<div class="box">

    <div class="emoji">🥺</div>

    <h1>I'm Sorry ❤️</h1>

    <input
        id="answer"
        type="text"
        placeholder="Type your answer..."
    >

    <button id="submit">Submit ❤️</button>

    <div id="result"></div>

</div>

<script>

const input = document.getElementById("answer");
const button = document.getElementById("submit");
const result = document.getElementById("result");

button.onclick = checkAnswer;

input.onkeydown = function(event) {
    if (event.key === "Enter") {
        checkAnswer();
    }
};

function checkAnswer() {

    const answer = input.value
        .trim()
        .toLowerCase();

    if (
        answer === "thik hai" ||
        answer === "theek hai" ||
        answer === "thik h" ||
        answer === "theek h"
    ) {

        result.innerHTML = "Thank you ❤️🥺";

        createHearts();

    } else {

        result.innerHTML = "Please forgive me 🥺❤️";

        setTimeout(function() {
            result.innerHTML = "";
            input.value = "";
            input.focus();
        }, 1500);
    }
}


function createHearts() {

    for (let i = 0; i < 30; i++) {

        const heart = document.createElement("div");

        heart.className = "heart";

        const list = [
            "❤️",
            "💕",
            "💗",
            "💖"
        ];

        heart.innerHTML =
            list[Math.floor(Math.random() * list.length)];

        heart.style.left =
            Math.random() * 100 + "%";

        heart.style.animationDelay =
            Math.random() * 1.5 + "s";

        document.body.appendChild(heart);

        setTimeout(function() {
            heart.remove();
        }, 4000);
    }
}

</script>

</body>
</html>
